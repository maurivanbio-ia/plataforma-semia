# Aplicação web
APP_PORT=8080
MAX_UPLOAD_MB=75
JOB_TTL_MINUTES=30

# Serviço watermarks-remover interno ao Docker Compose
WATERMARKS_SERVICE_URL=http://watermarks:8765
WATERMARKS_API_KEY=troque-esta-chave-em-producao

# Imagem do serviço de inspeção/limpeza. Troque por uma tag fixa se desejar reprodutibilidade estrita.
WATERMARKS_IMAGE=ghcr.io/guillaumemeyer/watermarks-remover:latest
